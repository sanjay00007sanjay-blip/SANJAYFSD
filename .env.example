# =====================================================================
# ECOFLOW AI - ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================

# ----------------- BACKEND (Node.js & Express & Socket.io) ----------
BACKEND_PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/ecoflow

# JWT Authentication Secret
JWT_SECRET=ecoflow-super-secret-production-key-2026
JWT_EXPIRES_IN=7d

# Python AI Analytics Microservice URL
AI_SERVICE_URL=http://127.0.0.1:8000

# Twilio SMS Alert Notifications
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567
COMPLIANCE_ALERT_RECIPIENT_PHONE=+15559876543

# ----------------- AI MICROSERVICE (Python FastAPI) ----------------
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0

# ----------------- FRONTEND (React & Vite) --------------------------
VITE_BACKEND_URL=http://localhost:5000
